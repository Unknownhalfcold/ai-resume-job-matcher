DATABASE_URL=sqlite:///./local_app.db
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://unknownhalfcold.github.io,https://jobmatcher.win,https://www.jobmatcher.win
AUTH_TOKEN_TTL_DAYS=14

# Server-only LLM configuration. Never expose these values to frontend code.
LLM_PROVIDER=deepseek
LLM_API_STYLE=chat_completions
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=replace-with-your-key
LLM_REQUEST_TIMEOUT_SECONDS=60
MAX_LLM_CONCURRENCY=10
RATE_LIMIT_SALT=replace-with-a-long-random-string
