DATABASE_URL=sqlite:///./local_app.db
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://unknownhalfcold.github.io,https://jobmatcher.win,https://www.jobmatcher.win
AUTH_TOKEN_TTL_DAYS=14

# Server-only LLM configuration. Never expose these values to frontend code.
LLM_PROVIDER=deepseek
LLM_API_STYLE=chat_completions
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=replace-with-your-key
LLM_REQUEST_TIMEOUT_SECONDS=28
LLM_MAX_OUTPUT_TOKENS=2000
LLM_RETRY_ON_SCHEMA_ERROR=false
MAX_LLM_CONCURRENCY=10
RATE_LIMIT_SALT=replace-with-a-long-random-string

# Supabase Auth. Publishable keys are public; never use service_role in the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# Older Supabase projects may use SUPABASE_ANON_KEY instead.
SUPABASE_REQUIRE_EMAIL_CONFIRMATION=true
